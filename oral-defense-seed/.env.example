# No external inference by default. The GUI refreshes public model catalogs.
# Restart the server after changing settings.
DATA_DIR=./data
TEXT_PROVIDER=mock
# TEXT_PROVIDER=compatible requires both fields below; API key may be empty locally.
TEXT_BASE_URL=
TEXT_MODEL=
TEXT_API_KEY=
# Chat Completions: json_object (default), or json_schema for llama.cpp.
TEXT_RESPONSE_FORMAT=json_object
# OpenCode Go / Zen candidates are fetched dynamically; choose a model in the GUI.
# Optional TEXT_PROVIDER=opencode-go or opencode sets the initial provider.
# TEXT_MODEL is optional for OpenCode: without it, explicitly select in the GUI.
# Empty keys use the existing OpenCode auth.json (read-only, no copy).
# Optional override for its location:
# OPENCODE_AUTH_FILE=/path/to/opencode/auth.json
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=
# Optional shared-key fallback (used when the provider-specific variable is absent).
# OPENCODE_API_KEY=
# Refresh while GUI is open; 0 disables automatic refresh, manual refresh remains.
MODEL_CATALOG_REFRESH_HOURS=24
TTS_PROVIDER=local
# Local presets: examiner=Kokoro Sky anime; answer/exercise=Piper LJSpeech.
# Download once: uv run python scripts/setup_speech.py
# SPEECH_MODELS_DIR=/path/to/models/speech
# TTS_PROVIDER=http: full endpoint accepting {input,voice,model,response_format:"wav"}.
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=alloy
TTS_API_KEY=
PRONUNCIATION_PROVIDER=unavailable
KALDI_MODEL_MANIFEST=models/manifest.json
